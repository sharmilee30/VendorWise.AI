# ==========================================
# VendorWise AI — Configuration Environment
# Copy to `.env` and fill in. `.env` is git-ignored; never commit real keys.
# ==========================================

# Backend port (Vite dev server proxies /api to this)
PORT=5001

# Google Gemini API key from https://aistudio.google.com/
# If left empty, the app uses the built-in rule-based reasoning engine.
GEMINI_API_KEY=

# Gemini model. Google retires models over time; if you see 404 "no longer available",
# pick a current one from the models your key can access.
GEMINI_MODEL=gemini-3.1-flash-lite

# --- Optional ---
# Log verbosity: debug | info | warn | error   (use debug when troubleshooting)
LOG_LEVEL=info

# Max AI analysis requests per IP per minute (protects your Gemini quota)
AI_RATE_LIMIT_PER_MIN=10

# Extra browser origins allowed to call the API (comma-separated). localhost is allowed by default.
# ALLOWED_ORIGINS=https://vendorwise.example.com

# Number of reverse-proxy hops in front of the app (1 on most hosts such as Render/Railway/Fly).
# Needed so the AI rate limit sees each visitor's real IP. Leave unset when running locally.
# TRUST_PROXY=1
